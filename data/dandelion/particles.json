[
    {
        "name": "laser_core",
        "duration": 4,
        "shapes": [
            {
                "type": "circle",
                "radius": 16,
                "color": "gfx.COLOR_RED"
            },
            {
                "type": "line",
                "thickness": 32,
                "length": 500,
                "color": "gfx.COLOR_RED",
                "rotation": "self.age * 0.125"
            }
        ]
    },
    {
        "name": "laser_triangle",
        "duration": 0.4,
        "shapes": [
            {
                "type": "triangle",
                "color": "gfx.COLOR_RED",
                "size": "(9 + self.random_2 * 9) * (1 - self.age / self.duration)",
                "rotation": "self.age * 4 - (self.random_1 * 4)"
            }
        ]
    },
    {
        "name": "laser_circle",
        "duration": 0.6,
        "shapes": [
            {
                "type": "circle",
                "color": "gfx.COLOR_RED",
                "radius": "(3 + self.random_2 * 6) * (1 - self.age / self.duration)",
                "rotation": "self.age * 4 - (self.random_1 * 4)"
            }
        ]
    },
    {
        "name": "bubble",
        "duration": "self.random_1 * 2 + 1",
        "dy": "self.age * -(self.random_3 * 4 + 4)",
        "create_on_death": "bubble_burst",
        "shapes": [
            {
                "type": "circle",
                "radius": "math.floor(self.random_2 * 2) + 2",
                "rotation": "self.age",
                "outline": 1,
                "color": "gfx.COLOR_BLUE"
            },
            {
                "type": "pixel",
                "dx": "-math.floor(self.random_2 * 2) - 1",
                "dy": "-math.floor(self.random_2 * 2) - 1",
                "color": "gfx.COLOR_WHITE"
            }
        ]
    },
    {
        "name": "bubble_burst_pixel",
        "duration": "self.random_1 * 0.25 + 0.25",
        "dx": "self.age * 24 * (self.random_2 * 2 - 1) + (self.random_3 * 2 - 1)",
        "dy": "(((self.age - 0.5) * 4) ^ 2) - 4 + (self.random_4 * 2 - 1)",
        "shapes": [
            {
                "type": "pixel",
                "color": "gfx.COLOR_BLUE",
                "alpha": "1 - (self.age / self.duration)"
            }
        ]
    },
    {
        "name": "raindrop",
        "duration": "self.random_2 * 0.25 + 0.5",
        "dx": "self.age * 64",
        "dy": "self.age * 256",
        "rotation": -0.125,
        "rotate_shapes": true,
        "create_on_death": "rain_splash",
        "shapes": [
            {
                "type": "circle",
                "color": "gfx.COLOR_DARK_BLUE",
                "radius": "self.random_1 * 1 + 2"
            },
            {
                "type": "triangle",
                "color": "gfx.COLOR_DARK_BLUE",
                "dy": "-(self.random_1 * 1 + 2)",
                "size": "self.random_1 * 1 + 3"
            }
        ]
    },
    {
        "name": "rain_splash",
        "duration": "self.random_1 * 0.25 + 0.5",
        "shapes": [
            {
                "type": "circle",
                "color": "gfx.COLOR_DARK_BLUE",
                "outline": 1,
                "radius": "2 * math.log(4 * self.age / self.duration + 1) + (self.random_2 * 2 + 1)",
                "alpha": "1 - (self.age / self.duration)"
            }
        ]
    },
    {
        "name": "flame",
        "duration": "self.random_1 * 0.5 + 0.5",
        "dx": "self.age * -(self.random_2 * 8 + 8)",
        "dy": "self.age * -(self.random_3 * 8 + 8)",
        "shapes": [
            {
                "type": "triangle",
                "size": "(1 - self.age / self.duration) * (self.random_4 * 4 + 4)",
                "rotation": "self.age + self.random_1",
                "color": "self.age > 0.25 and gfx.COLOR_RED or (self.age > 0.1 and gfx.COLOR_ORANGE or gfx.COLOR_YELLOW)"
            }
        ]
    },
    {
        "name": "small_smoke",
        "duration": "self.random_1 * 0.5 + 0.5",
        "dx": "self.age * -(self.random_2 * 4 + 4) - 2",
        "dy": "self.age * -(self.random_3 * 8 + 8) - 2",
        "shapes": [
            {
                "type": "circle",
                "radius": "self.random_4 * 2 + 1",
                "rotation": "self.age",
                "color": "self.random_1 > 0.5 and gfx.COLOR_DARK_GRAY or gfx.COLOR_LIGHT_GRAY"
            }
        ]
    },
    {
        "name": "portal_pixel",
        "shapes": [
            {
                "type": "pixel",
                "color": "self.random_1 > 0.5 and -1 or gfx.COLOR_DARK_PURPLE",
                "alpha": "1 - (self.age / self.duration)"
            }
        ]
    },
    {
        "name": "damage_number",
        "duration": 0.5,
        "dx": "self.age * (self.random_1 * 16 + 16) * (self.random_2 > 0.5 and 1 or -1)",
        "dy": "(self.age * (self.random_3 * 4 + 12) - 3) ^ 2 - 16",
        "shapes": [
            {
                "type": "text",
                "text": "math.floor(self.random_4 * 99 + 1)",
                "align": "center",
                "scale": "2 * (self.age < 0.25 and 1 or (1 - (self.age - 0.25) / (self.duration - 0.25)))",
                "color": "gfx.COLOR_RED",
                "rotation": "self.age * (self.random_4 * 0.25 + 0.1) * (self.random_2 > 0.5 and 1 or -1)",
                "outline": "gfx.COLOR_DARK_PURPLE"
            }
        ]
    },
    {
        "name": "xp_number",
        "duration": 0.5,
        "dy": "math.log(self.age) * -(self.random_1 * 2 + 2) - 16",
        "shapes": [
            {
                "type": "text",
                "text": "'+'..math.floor(self.random_4 * 39 + 10)..'XP'",
                "align": "center",
                "color": "(self.age % 0.15) > 0.075 and gfx.COLOR_YELLOW or gfx.COLOR_WHITE",
                "outline": "(self.age % 0.15) > 0.075 and gfx.COLOR_BROWN or gfx.COLOR_DARK_PURPLE"
            }
        ]
    },
    {
        "name": "dandelion",
        "duration": 10,
        "rotation": "math.sin(self.age*2)*0.2",
        "rotate_shapes": true,
        "dx": "self.age * (self.random_1 * 32 + 96)",
        "dy": "math.sin(self.age/(self.random_2 + 1))*16",
        "shapes": [
            {
                "type": "line",
                "color": "gfx.COLOR_DARK_GREEN",
                "rotation": 0.5,
                "length": 4
            },
            {
                "type": "line",
                "color": "gfx.COLOR_WHITE",
                "length": 7,
                "rotation": "self.random_3 * 0.5 - 0.25",
                "centered": true
            },
            {
                "type": "line",
                "color": "gfx.COLOR_WHITE",
                "rotation": "self.random_4 * 0.5 - 0.25",
                "length": 7,
                "centered": true
            },
            {
                "type": "line",
                "color": "gfx.COLOR_WHITE",
                "length": 7,
                "centered": true
            }
        ]
    },
    {
        "name": "daisy",
        "duration": 1,
        "dx": "math.log(15 * self.age + 1) * (self.random_1 * 5 + 5) * util.sign(self.random_3 - 0.5)",
        "dy": "math.log(15 * self.age + 1) * (self.random_2 * 5 + 5) * util.sign(self.random_4 - 0.5)",
        "rotation": "self.age * (self.random_1 * 0.25 + 0.25) * util.sign(self.random_4 - 0.5)",
        "shapes": [
            {
                "type": "circle",
                "color": "gfx.COLOR_LIGHT_GRAY",
                "radius": 2,
                "dx": 4,
                "alpha": "1 - self.age / self.duration"
            },
            {
                "type": "circle",
                "color": "gfx.COLOR_LIGHT_GRAY",
                "radius": 2,
                "dy": -4,
                "alpha": "1 - self.age / self.duration"
            },
            {
                "type": "circle",
                "color": "gfx.COLOR_LIGHT_GRAY",
                "radius": 2,
                "dx": -4,
                "alpha": "1 - self.age / self.duration"
            },
            {
                "type": "circle",
                "color": "gfx.COLOR_LIGHT_GRAY",
                "radius": 2,
                "dy": 4,
                "alpha": "1 - self.age / self.duration"
            },
            {
                "type": "circle",
                "color": "gfx.COLOR_WHITE",
                "radius": 2,
                "dx": 3,
                "dy": 3,
                "alpha": "1 - self.age / self.duration"
            },
            {
                "type": "circle",
                "color": "gfx.COLOR_WHITE",
                "radius": 2,
                "dx": 3,
                "dy": -3,
                "alpha": "1 - self.age / self.duration"
            },
            {
                "type": "circle",
                "color": "gfx.COLOR_WHITE",
                "radius": 2,
                "dx": -3,
                "dy": 3,
                "alpha": "1 - self.age / self.duration"
            },
            {
                "type": "circle",
                "color": "gfx.COLOR_WHITE",
                "radius": 2,
                "dx": -3,
                "dy": -3,
                "alpha": "1 - self.age / self.duration"
            },
            {
                "type": "circle",
                "color": "gfx.COLOR_ORANGE",
                "radius": 3,
                "alpha": "1 - self.age / self.duration"
            },
            {
                "type": "circle",
                "color": "gfx.COLOR_YELLOW",
                "radius": 3,
                "alpha": "0.5 * (1 - self.age / self.duration)"
            }
        ]
    }
]